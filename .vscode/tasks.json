{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FA2: backend verify",
      "type": "shell",
      "command": "bash mvnw verify",
      "windows": {
        "command": ".\\mvnw.cmd verify"
      },
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "FA2: demo backend",
      "type": "shell",
      "command": "bash mvnw spring-boot:run -Dspring-boot.run.profiles=demo",
      "windows": {
        "command": ".\\mvnw.cmd spring-boot:run -Dspring-boot.run.profiles=demo"
      },
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "FA2: frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    }
  ]
}
